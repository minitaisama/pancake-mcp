{
  "name": "pancake_trace",
  "description": "Get the normalized Diagnostics v2 evidence graph and optional event timeline for a conversation, message, delivery, or order across scopes: conversation | interactive | order | outreach | all. Read-only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "description": "Any target reference: Pancake URL (https://pancake.vn/...?c_id=...), Pancake conversation ID (PAGEID_PSID, POSTID_COMMENTID, pzl_u_...), local UUID, message ID (m_...), or Admin Order ID"
      },
      "pancakeUrl": {
        "type": "string",
        "description": "Pancake conversation URL (https://pancake.vn/...?c_id=...)"
      },
      "pancakeConversationId": {
        "type": "string",
        "description": "Exact Pancake conversation ID (e.g. 1131614906706493_27102859622703796)"
      },
      "conversationId": {
        "type": "string",
        "description": "Local database conversation UUID"
      },
      "messageId": {
        "type": "string",
        "description": "Exact Pancake message/comment ID"
      },
      "deliveryId": {
        "type": "string",
        "description": "Outbound delivery UUID"
      },
      "orderId": {
        "type": "string",
        "description": "VietLicense Admin Order ID or local order push UUID"
      },
      "scope": {
        "type": "string",
        "enum": [
          "conversation",
          "interactive",
          "order",
          "outreach",
          "all"
        ],
        "description": "Trace scope (default: all)"
      },
      "includeTimeline": {
        "type": "boolean",
        "description": "Include chronological normalized event timeline (default: true)"
      },
      "providerRead": {
        "type": "string",
        "enum": [
          "auto",
          "never",
          "always"
        ],
        "description": "Pancake GET mode (default: auto)"
      },
      "windowMinutes": {
        "type": "number",
        "description": "Lookback window in minutes (default: 60)"
      },
      "redactIdentifiers": {
        "type": "boolean",
        "description": "Redact operational identifiers (default: false)"
      }
    },
    "additionalProperties": false
  }
}
