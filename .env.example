# Ops / Diagnostics API (VietLicense Chat or compatible backend)
VIETLICENSE_CHAT_OPS_URL=https://chat.example.com
CHAT_DIAGNOSTICS_TOKEN=your_diagnostics_bearer_token

# Direct Pancake Public API (https://pages.fm/api/public_api)
PANCAKE_API_URL=https://pages.fm
PANCAKE_PAGE_ID=your_facebook_page_id
PANCAKE_ACCESS_TOKEN=your_facebook_page_access_token

# Optional secondary connector (Zalo Personal on Pancake)
PANCAKE_ZALO_PAGE_ID=pzl_your_zalo_page_id
PANCAKE_ZALO_ACCESS_TOKEN=your_zalo_page_access_token
